# Database Configuration (SQLite or PostgreSQL)
DATABASE_URL="file:./dev.db"

# AI Provider Configuration (Google Gemini)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.6-flash"

# Speech-to-Text & Text-to-Speech (Deepgram)
DEEPGRAM_API_KEY="your-deepgram-api-key-here"
DEEPGRAM_STT_MODEL="nova-2"
DEEPGRAM_TTS_VOICE="aura-asteria-en"

# Host Agent OS Gateway Configuration
HOST_AGENT_URL="http://127.0.0.1:8765"
HOST_AGENT_PORT="8765"
HOST_AGENT_SECRET="super-secret-host-agent-key-change-in-prod-12345"

# Web Application Server
PORT="3001"
