{
  "name": "ai-pc-controller",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "concurrently -n \"agent,web\" -c \"cyan,blue\" \"npm run start:agent\" \"npm run start --workspace=apps/web\"",
    "dev:all": "concurrently -n \"agent,web\" -c \"cyan,blue\" \"npm run start:agent\" \"npm run dev --workspace=apps/web\"",
    "dev": "npm run dev --workspace=apps/web",
    "start:agent": "npm run start --workspace=apps/host-agent",
    "build": "npm run build --workspaces",
    "build:native": "npm run build --workspace=packages/native",
    "setup:browser": "npx playwright install chromium --with-deps",
    "setup": "npm install && npm run db:push && npm run setup:browser",
    "test": "node test-suite.js",
    "db:push": "dotenv -e .env -- npx prisma db push --schema=packages/database/prisma/schema.prisma",
    "db:generate": "npm run db:generate --workspace=packages/database"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "dotenv-cli": "^7.4.2",
    "typescript": "^5.4.5"
  }
}
